{
  "name": "equilibrium-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Chemical equilibrium for General Chemistry: watch a mixture react until Q reaches K with the forward and reverse rates equal, work ICE tables against a live simulation, apply Le Chatelier stresses and see whether Q or K moved, and find ΔH° and ΔS° from a van 't Hoff plot.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenLyceum/EquilibriumLab.git"
  },
  "keywords": [
    "simulation",
    "SceneryStack",
    "interactive",
    "physics",
    "chemistry",
    "chemical equilibrium",
    "equilibrium constant",
    "reaction quotient",
    "ICE table",
    "Le Chatelier's principle",
    "van 't Hoff equation",
    "Kc",
    "Kp",
    "education",
    "pwa"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "release": "npm run check && npm run lint && npm run build && npm test && npm version patch && git push && git push --tags",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "tsx scripts/test-fuzz.ts",
    "test:fuzz:quick": "tsx scripts/test-fuzz.ts 10",
    "test:fuzz:long": "tsx scripts/test-fuzz.ts 300",
    "icons": "tsx scripts/generate-icons.ts",
    "clean": "rm -rf dist",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "lodash": "~4.18.1",
    "three": "~0.125.2",
    "brace-expansion": "~5.0.12"
  }
}
